{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "python3 -I -B \"${CURSOR_PLUGIN_ROOT}/hooks/native-hook.py\" cursor sessionStart",
        "timeout": 10
      }
    ],
    "postToolUse": [
      {
        "command": "python3 -I -B \"${CURSOR_PLUGIN_ROOT}/hooks/native-hook.py\" cursor postToolUse",
        "timeout": 10
      }
    ],
    "stop": [
      {
        "command": "python3 -I -B \"${CURSOR_PLUGIN_ROOT}/hooks/native-hook.py\" cursor stop",
        "timeout": 10,
        "loop_limit": 3
      }
    ]
  }
}
