{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "name": "planweft-sessionstart",
            "type": "command",
            "command": "python3 -I -B \"${extensionPath}/hooks/native-hook.py\" gemini SessionStart",
            "timeout": 10000
          }
        ]
      }
    ],
    "BeforeAgent": [
      {
        "hooks": [
          {
