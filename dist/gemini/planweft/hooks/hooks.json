        ]
      }
    ],
    "AfterTool": [
      {
        "hooks": [
          {
            "name": "planweft-aftertool",
            "type": "command",
            "command": "python3 -I -B \"${extensionPath}/hooks/native-hook.py\" gemini AfterTool",
            "timeout": 10000
          }
        ]
      }
    ],
    "PreCompress": [
      {
        "hooks": [
          {
            "name": "planweft-precompress",
            "type": "command",
            "command": "python3 -I -B \"${extensionPath}/hooks/native-hook.py\" gemini PreCompress",
            "timeout": 10000
          }
